 * SPDX-License-Identifier: Apache-2.0
 *
 * ESP32-S3-DevKitC-1: onboard WS2812 addressable RGB LED over SPI3.
 *
 * The LED data line is MOSI on GPIO48. The WS2812 SPI driver needs the bus to
 * idle low and the one/zero bit frames below.
 */

#include <zephyr/dt-bindings/led/led.h>

&pinctrl {
	spim3_default: spim3_default {
		group2 {
			pinmux = <SPIM3_MOSI_GPIO48>;
		};
	};
};

&spi3 {
	/* Workaround required by the WS2812 SPI driver. */
	line-idle-low;

	led_strip: ws2812@0 {
		compatible = "worldsemi,ws2812-spi";

		reg = <0>;
		spi-max-frequency = <6400000>;

		chain-length = <1>;
		spi-cpha;
		spi-one-frame = <0xf0>;  /* 11110000: 625 ns high, 625 ns low */
		spi-zero-frame = <0xc0>; /* 11000000: 312.5 ns high, 937.5 ns low */
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
	};
};

/ {
	aliases {
		led-strip = &led_strip;
	};
};
